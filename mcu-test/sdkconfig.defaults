CONFIG_IDF_TARGET="esp32c6"

# 4 MB header boots on both N4 and N8 parts; Key Box uses N8
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Console on the USB Serial/JTAG port (IO12/IO13); UART0 stays free for RS-485
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# BLE only, NimBLE host (Wi-Fi provisioning transport)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
